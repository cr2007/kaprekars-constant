{
  "name": "kaprekars-constant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun node_modules/vite/bin/vite.js",
    "build": "bun check -b && bun --bun node_modules/vite/bin/vite.js build",
    "lint": "oxlint",
    "preview": "bun --bun node_modules/vite/bin/vite.js preview",
    "test": "bun test ./src",
    "test:e2e": "bun --bun run build && bun test ./e2e",
    "check:unused": "knip",
    "check:tsdoc": "bun scripts/check-tsdoc.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@microsoft/tsdoc": "0.17.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "knip": "6.44.2",
    "oxlint": "^1.92.0",
    "playwright-core": "^1.65.0",
    "shadcn": "^4.23.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
